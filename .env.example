# Smart Transit & Crash Telemetry Hub — Environment Variables
# Copy this to .env and fill in your values.
# DO NOT commit the real .env file to git.

# ── Java Backend (Railway) ────────────────────────────────────────────────────
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_NAME=smart_transit
DB_USER=root
DB_PASS=your_db_password

# HTTP port (Railway sets this automatically)
PORT=8080

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# Set VITE_API_BASE in the Vercel dashboard under Environment Variables
# e.g. https://your-backend.up.railway.app/api
VITE_API_BASE=https://your-backend.up.railway.app/api

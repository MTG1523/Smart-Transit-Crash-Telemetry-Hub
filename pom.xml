<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     Smart Transit & Crash Telemetry Hub — Maven Build File
     Author  : m.kane
     Purpose : Compile, package, and run the pure-Java JDBC application.
     ============================================================================= -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── Artifact Coordinates ─────────────────────────────────────────── -->
    <groupId>com.mkane</groupId>
    <artifactId>smart-transit-hub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Smart Transit &amp; Crash Telemetry Hub</name>
    <description>
        Pure Java + JDBC telemetry simulation system with DAO pattern, batch
        processing, ACID crash transactions, and ML CSV export pipeline.
    </description>

    <!-- ── Java Version ──────────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mysql.connector.version>8.3.0</mysql.connector.version>
    </properties>

    <!-- ── Dependencies ──────────────────────────────────────────────────── -->
    <dependencies>

        <!-- MySQL Connector/J — the ONLY external dependency (no Spring/Hibernate) -->
        <!-- JDBC 4.2 compliant, supports rewriteBatchedStatements, streaming RS    -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JUnit 5 — optional unit testing of DAO and physics logic -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ── Build Plugins ─────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- Compiler plugin: enforce Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Shade plugin: fat JAR with mysql-connector-j bundled.
                 Run with: java -jar target/smart-transit-hub-1.0.0-SNAPSHOT.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <!-- Entry point -->
                                    <mainClass>com.mkane.transit.MainController</mainClass>
                                </transformer>
                                <!-- Merge service files so JDBC driver auto-registration works -->
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: run JUnit 5 tests during mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>
    </build>

</project>
